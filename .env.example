# Скопируйте в .env и отредактируйте:  cp .env.example .env

# Порт, на котором будет доступен веб-интерфейс
APP_PORT=8080

# Учётные данные PostgreSQL
POSTGRES_USER=inv
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=inventory

# Секрет для подписи сессионных cookie.
# Сгенерировать:  openssl rand -hex 32
SECRET_KEY=replace-with-openssl-rand-hex-32

# Первый администратор (создаётся при первом запуске).
# Пароль потом можно сменить в интерфейсе.
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-admin-password

# --- Уведомления о низком остатке картриджей (необязательно) ---
# Можно задать здесь как значения по умолчанию, либо настроить в интерфейсе
# (вкладка «Данные» → «Уведомления»). Настройки из интерфейса имеют приоритет.
# Telegram:
#TELEGRAM_BOT_TOKEN=123456:AA...
#TELEGRAM_CHAT_ID=-1001234567890
# E-mail (SMTP):
#SMTP_HOST=smtp.yandex.ru
#SMTP_PORT=587
#SMTP_USER=bot@example.ru
#SMTP_PASSWORD=app-password
#SMTP_FROM=bot@example.ru
#EMAIL_TO=it@example.ru
#SMTP_TLS=1
